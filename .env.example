# NVIDIA Nemotron API Configuration
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Tavily Search API Configuration
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_MAX_SEARCHES=20

# Durable PostgreSQL Storage (Optional; e.g. Neon, Supabase)
DATABASE_URL=postgres://user:password@host:5432/evidencecheck?sslmode=require

# Public Deployment Credit Guard (Optional; set true only with durable protection)
PUBLIC_LIVE_INVESTIGATION_ENABLED=false


