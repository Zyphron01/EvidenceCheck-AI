{
  "manifest_version": 3,
  "name": "EvidenceCheck AI — Fact & Citation Auditor",
  "version": "1.0.0",
  "description": "Audit factual assertions on any webpage with NVIDIA Nemotron & Tavily. Deterministic citation auditing eliminates AI hallucinations.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "EvidenceCheck AI — Audit Claim",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "scripting"
  ]
}
